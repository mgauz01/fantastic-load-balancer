{
  "id": "level_02",
  "index": 2,
  "title": "Weighted Split",
  "briefMarkdown": "Observe a 70/30 weighted pool. Rules stay fixed; success means keeping the cumulative rate above threshold.",
  "pools": [
    {
      "id": "split",
      "name": "Split Pool",
      "stickyEnabled": false,
      "backends": [
        { "id": "heavy", "name": "heavy", "weight": 70 },
        { "id": "light", "name": "light", "weight": 30 }
      ]
    }
  ],
  "listeners": {
    "80": {
      "defaultRule": { "priority": 100, "action": "route", "targetPoolId": "split" },
      "starterRules": []
    }
  },
  "autoRecovery": true,
  "recoveryTicks": 12,
  "displayHeaders": [],
  "passThreshold": { "successRate": 0.9, "durationTicks": 45 },
  "trafficSpawns": [
    {
      "everyTicks": 1,
      "count": 1,
      "template": {
        "host": "metrics.example",
        "path": "/report",
        "method": "GET",
        "listenerPort": 80
      }
    }
  ],
  "healthEvents": []
}
