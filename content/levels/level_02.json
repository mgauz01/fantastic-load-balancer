{
  "id": "level_02",
  "index": 2,
  "title": "Weighted Split",
  "briefMarkdown": "The default rule denies traffic on :80. You start paused — open RULES, add a host rule for metrics.example to the Split Pool, SAVE, then RESUME. Watch the 70/30 weighted split while traffic runs.",
  "playHint": "RULES tab → host metrics.example → Split Pool → SAVE → RESUME",
  "ruleCoach": {
    "priority": 10,
    "matchType": "host",
    "matchValue": "metrics.example",
    "targetPoolId": "split"
  },
  "pools": [
    {
      "id": "split",
      "name": "Split Pool",
      "stickyEnabled": false,
      "backends": [
        { "id": "heavy", "name": "heavy", "weight": 70 },
        { "id": "light", "name": "light", "weight": 30 }
      ]
    }
  ],
  "listeners": {
    "80": {
      "defaultRule": { "priority": 100, "action": "deny" },
      "starterRules": []
    }
  },
  "autoRecovery": true,
  "recoveryTicks": 12,
  "displayHeaders": [],
  "passThreshold": { "successRate": 0.9, "durationTicks": 45 },
  "trafficSpawns": [
    {
      "everyTicks": 1,
      "count": 1,
      "template": {
        "host": "metrics.example",
        "path": "/report",
        "method": "GET",
        "listenerPort": 80
      }
    }
  ],
  "healthEvents": []
}
